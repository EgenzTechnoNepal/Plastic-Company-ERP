# Copy to .env and fill in real values. Never commit the real .env file.

# --- Core ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://greenflow:greenflow@localhost:5432/greenflow_erp
# Set to True only for local/offline sandbox runs where Postgres is unavailable.
# Never set this in staging/production.
DEV_USE_SQLITE=False
# Optional SQLite file for DEV_USE_SQLITE (e.g. a separate clean demo database).
# DEV_SQLITE_PATH=db.demo.sqlite3

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS / CSRF (comma-separated, explicit — never use wildcard in production) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- File storage ---
DJANGO_MEDIA_ROOT=media
# Set to "s3" (or another supported backend) in production; local filesystem in dev.
STORAGE_BACKEND=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI / future OCR scan (S6c — wire after core system is complete) ---
# Get a key at https://aistudio.google.com/apikey — leave blank until then.
# Use Gemini Flash / Flash-Lite only (cheap). One provider for Draft LC + Gate bill scan.
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional alias; leave empty to reuse GOOGLE_GEMINI_API_KEY when scan is built.
OCR_PROVIDER_API_KEY=

# --- Other integrations (adapters only — no live calls required yet) ---
OPENAI_API_KEY=
WHATSAPP_BUSINESS_TOKEN=
SMS_GATEWAY_API_KEY=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
IRD_CBMS_API_BASE_URL=
IRD_CBMS_API_KEY=

# --- Sentry (production only) ---
SENTRY_DSN=
