# Copy to `.env` next to docker-compose files. Never commit real `.env`.

# --- Neon Postgres (production) ---
# Use the Neon *pooler* URL. Prefer sslmode=require (drop channel_binding if drivers complain).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DB_CONN_MAX_AGE=0
DEV_USE_SQLITE=False

# --- Django production ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=erpsystem.egenztechnonepal.com,www.erpsystem.egenztechnonepal.com,localhost,127.0.0.1,backend
SECURE_SSL_REDIRECT=False

# --- CORS / CSRF (match your public URL scheme) ---
CORS_ALLOWED_ORIGINS=http://erpsystem.egenztechnonepal.com,https://erpsystem.egenztechnonepal.com
CSRF_TRUSTED_ORIGINS=http://erpsystem.egenztechnonepal.com,https://erpsystem.egenztechnonepal.com

# --- Demo seed / admin bootstrap ---
SEED_DEMO=1
ENSURE_ADMIN=1
ADMIN_EMAIL=admin@ecowrap.com
ADMIN_PASSWORD=change-me-after-first-login
ENSURE_ADMIN_RESET=1

# --- Local Postgres (docker compose / docker-compose.yml only) ---
POSTGRES_DB=greenflow_erp
POSTGRES_USER=greenflow
POSTGRES_PASSWORD=greenflow

# --- Ports ---
HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_PORT=8082
BACKEND_PORT=8000
